<% content_for :title, "API Tokens - QuantumQuery" %>

<!-- Premium API Tokens Page -->
<div class="bg-gradient-to-br from-slate-50 via-purple-50 to-indigo-50 dark:from-slate-900 dark:via-slate-800 dark:to-slate-900 min-h-screen pt-20">
  <!-- Breadcrumb & Navigation -->
  <div class="bg-white/80 dark:bg-slate-800/80 backdrop-blur-sm border-b border-slate-200/50 dark:border-slate-700/50 sticky top-16 z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <nav class="flex items-center space-x-2 text-sm">
        <%= link_to "Dashboard", root_path, class: "text-slate-500 dark:text-slate-400 hover:text-purple-600 dark:hover:text-purple-400 transition-colors" %>
        <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
        <span class="text-slate-900 dark:text-slate-100 font-medium">API Tokens</span>
      </nav>
    </div>
  </div>

  <!-- Hero Header Section -->
  <div class="relative bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 shadow-xl">
    <div class="absolute inset-0 bg-black/20"></div>
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width="60" height="60" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg"%3E%3Cg fill="none" fill-rule="evenodd"%3E%3Cg fill="%23ffffff" fill-opacity="1"%3E%3Cpath d="M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')]"></div>
    </div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between">
        <div class="flex-1">
          <div class="flex items-center space-x-4 mb-4">
            <div class="p-3 bg-white/20 backdrop-blur-sm rounded-xl">
              <svg class="h-10 w-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
              </svg>
            </div>
            <div>
              <h1 class="text-4xl lg:text-5xl font-bold text-white mb-2">API Tokens</h1>
              <p class="text-xl text-purple-100">Manage authentication tokens for API access</p>
            </div>
          </div>

          <!-- Stats -->
          <div class="flex flex-wrap items-center gap-6 text-purple-100">
            <div class="flex items-center space-x-2">
              <div class="h-8 w-8 bg-white/20 rounded-lg flex items-center justify-center">
                <svg class="h-4 w-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 8a6 6 0 01-7.743 5.743L10 14l-1 1-1 1H6v2H2v-4l4.257-4.257A6 6 0 1118 8zm-6-4a1 1 0 100 2 2 2 0 012 2 1 1 0 102 0 4 4 0 00-4-4z" clip-rule="evenodd"></path>
                </svg>
              </div>
              <div>
                <div class="text-sm font-medium opacity-90">Total Tokens</div>
                <div class="text-lg font-bold"><%= @api_tokens.count %></div>
              </div>
            </div>
            
            <div class="flex items-center space-x-2">
              <div class="h-8 w-8 bg-green-500/30 rounded-lg flex items-center justify-center border border-green-300/50">
                <svg class="h-4 w-4 text-green-100" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
              </div>
              <div>
                <div class="text-sm font-medium opacity-90">Active</div>
                <div class="text-lg font-bold"><%= @api_tokens.select(&:active?).count %></div>
              </div>
            </div>
            
            <div class="flex items-center space-x-2">
              <div class="h-8 w-8 bg-red-500/30 rounded-lg flex items-center justify-center border border-red-300/50">
                <svg class="h-4 w-4 text-red-100" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M13.477 14.89A6 6 0 015.11 6.524l8.367 8.368zm1.414-1.414L6.524 5.11a6 6 0 018.367 8.367zM18 10a8 8 0 11-16 0 8 8 0 0116 0z" clip-rule="evenodd"></path>
                </svg>
              </div>
              <div>
                <div class="text-sm font-medium opacity-90">Revoked</div>
                <div class="text-lg font-bold"><%= @api_tokens.select(&:revoked?).count %></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Action Button -->
        <div class="mt-6 lg:mt-0">
          <%= link_to new_api_token_path, class: "inline-flex items-center justify-center px-6 py-3 bg-white border border-transparent rounded-xl shadow-lg text-sm font-semibold text-indigo-600 hover:bg-indigo-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-white transform hover:scale-105 transition-all duration-200" do %>
            <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            Create New Token
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <% if @api_tokens.any? %>
      <!-- Token Cards -->
      <div class="space-y-4">
        <% @api_tokens.each do |token| %>
          <div class="group bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden hover:shadow-lg transition-all duration-200">
            <div class="p-6">
              <div class="flex items-start gap-4">
                <!-- Icon -->
                <div class="flex-shrink-0 mt-1">
                  <div class="h-14 w-14 rounded-2xl flex items-center justify-center
                    <%= if token.revoked?
                          'bg-gradient-to-br from-red-400 to-red-500'
                        elsif token.expired?
                          'bg-gradient-to-br from-amber-400 to-amber-500'
                        else
                          'bg-gradient-to-br from-indigo-400 to-purple-500'
                        end %>">
                    <svg class="h-7 w-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
                    </svg>
                  </div>
                </div>
                
                <!-- Main Content -->
                <div class="flex-1 min-w-0">
                  <%= link_to api_token_path(token), class: "block mb-3" do %>
                    <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                      <%= token.name %>
                    </h3>
                  <% end %>
                  
                  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-slate-600 dark:text-slate-400 mb-4">
                    <div class="flex items-center gap-1.5">
                      <svg class="h-4 w-4 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                      <span>Last used: <%= token.last_used_at ? time_ago_in_words(token.last_used_at) + " ago" : "Never" %></span>
                    </div>
                    
                    <div class="flex items-center gap-1.5">
                      <svg class="h-4 w-4 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                      </svg>
                      <span><%= token.usage_today %> requests today</span>
                    </div>
                    
                    <div class="flex items-center gap-1.5">
                      <svg class="h-4 w-4 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                      </svg>
                      <span>Expires: <%= token.expires_at ? token.expires_at.strftime("%b %d, %Y") : "Never" %></span>
                    </div>
                  </div>

                  <!-- Scopes/Permissions -->
                  <% if token.respond_to?(:scopes_array) && token.scopes_array.any? %>
                    <div class="flex flex-wrap gap-2">
                      <% token.scopes_array.each do |scope| %>
                        <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium bg-indigo-100 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300">
                          <%= scope %>
                        </span>
                      <% end %>
                    </div>
                  <% end %>
                </div>

                <!-- Right Side: Status & Actions -->
                <div class="flex flex-col items-end gap-3 flex-shrink-0">
                  <!-- Status Badge -->
                  <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-semibold
                    <%= if token.revoked?
                          'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400'
                        elsif token.expired?
                          'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400'
                        else
                          'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400'
                        end %>">
                    <%= if token.revoked?
                          'Revoked'
                        elsif token.expired?
                          'Expired'
                        else
                          'Active'
                        end %>
                  </span>
                  
                  <!-- Action Buttons -->
                  <div class="flex items-center gap-2">
                    <%= link_to api_token_path(token), class: "inline-flex items-center px-4 py-2 bg-white dark:bg-slate-700 border border-slate-300 dark:border-slate-600 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-600 transition-colors" do %>
                      View Details
                    <% end %>
                    
                    <% if token.active? %>
                      <%= link_to revoke_api_token_path(token), method: :post, data: { confirm: "Are you sure you want to revoke this token?" }, class: "inline-flex items-center p-2 border border-slate-300 dark:border-slate-600 rounded-lg text-amber-600 dark:text-amber-400 hover:bg-amber-50 dark:hover:bg-amber-900/10 transition-colors" do %>
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path>
                        </svg>
                      <% end %>
                    <% end %>
                    
                    <%= link_to api_token_path(token), method: :delete, data: { confirm: "Are you sure you want to delete this token?" }, class: "inline-flex items-center p-2 border border-slate-300 dark:border-slate-600 rounded-lg text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/10 transition-colors" do %>
                      <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                      </svg>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
        <div class="px-6 py-16 text-center">
          <div class="mx-auto h-20 w-20 bg-gradient-to-br from-indigo-100 to-purple-100 dark:from-indigo-900/30 dark:to-purple-900/30 rounded-2xl flex items-center justify-center mb-6">
            <svg class="h-10 w-10 text-indigo-500 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
            </svg>
          </div>
          
          <h3 class="text-xl font-semibold text-slate-900 dark:text-slate-100 mb-2">No API Tokens Yet</h3>
          <p class="text-slate-600 dark:text-slate-400 mb-8 max-w-md mx-auto">Create your first API token to start integrating with QuantumQuery's API</p>

          <%= link_to new_api_token_path, class: "inline-flex items-center px-6 py-3 bg-indigo-600 border border-transparent rounded-lg shadow-sm text-sm font-semibold text-white hover:bg-indigo-700 transition-colors" do %>
            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            Create Your First Token
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>