<% content_for :title, "Analysis History - QuantumQuery" %>

<!-- Premium Analysis History Page -->
<div class="bg-gradient-to-br from-slate-50 via-purple-50 to-indigo-50 dark:from-slate-900 dark:via-slate-800 dark:to-slate-900 min-h-screen pt-20">
  <!-- Breadcrumb & Navigation -->
  <div class="bg-white/80 dark:bg-slate-800/80 backdrop-blur-sm border-b border-slate-200/50 dark:border-slate-700/50 sticky top-16 z-10">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <nav class="flex items-center space-x-2 text-sm">
        <%= link_to "Dashboard", root_path, class: "text-slate-500 dark:text-slate-400 hover:text-purple-600 dark:hover:text-purple-400 transition-colors" %>
        <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
        <% if params[:dataset_id].present? && @analysis_requests.first&.dataset %>
          <%= link_to @analysis_requests.first.dataset.name, @analysis_requests.first.dataset, class: "text-slate-500 dark:text-slate-400 hover:text-purple-600 dark:hover:text-purple-400 transition-colors" %>
          <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        <% end %>
        <span class="text-slate-900 dark:text-slate-100 font-medium">Analysis History</span>
      </nav>
    </div>
  </div>

  <!-- Hero Header Section -->
  <div class="relative bg-gradient-to-r from-purple-600 via-indigo-600 to-blue-600 shadow-xl">
    <div class="absolute inset-0 bg-black/20"></div>
    <!-- Animated Background Pattern -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width="60" height="60" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg"%3E%3Cg fill="none" fill-rule="evenodd"%3E%3Cg fill="%23ffffff" fill-opacity="1"%3E%3Cpath d="M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')]"></div>
    </div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between space-y-6 lg:space-y-0">
        <!-- Header Content -->
        <div class="flex-1">
          <div class="flex items-center space-x-4 mb-4">
            <div class="p-3 bg-white/20 backdrop-blur-sm rounded-xl">
              <svg class="h-10 w-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
              </svg>
            </div>
            <div>
              <h1 class="text-4xl lg:text-5xl font-bold text-white mb-2">
                <% if params[:dataset_id].present? && @analysis_requests.first&.dataset %>
                  <%= @analysis_requests.first.dataset.name %> Analysis
                <% else %>
                  Analysis History
                <% end %>
              </h1>
              <p class="text-xl text-purple-100">
                <% if params[:dataset_id].present? %>
                  View all analysis requests for this dataset
                <% else %>
                  Review and manage all your data analysis requests
                <% end %>
              </p>
            </div>
          </div>

          <!-- Stats Bar -->
          <div class="flex flex-wrap items-center gap-6 text-purple-100">
            <div class="flex items-center space-x-2">
              <div class="h-8 w-8 bg-white/20 rounded-lg flex items-center justify-center">
                <svg class="h-4 w-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"></path>
                  <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd"></path>
                </svg>
              </div>
              <div>
                <div class="text-sm font-medium opacity-90">Total Requests</div>
                <div class="text-lg font-bold"><%= @analysis_requests.total_count %></div>
              </div>
            </div>
            
            <div class="flex items-center space-x-2">
              <div class="h-8 w-8 bg-green-500/30 rounded-lg flex items-center justify-center border border-green-300/50">
                <svg class="h-4 w-4 text-green-100" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
              </div>
              <div>
                <div class="text-sm font-medium opacity-90">Completed</div>
                <div class="text-lg font-bold"><%= @analysis_requests.where(status: :completed).count %></div>
              </div>
            </div>
            
            <div class="flex items-center space-x-2">
              <div class="h-8 w-8 bg-amber-500/30 rounded-lg flex items-center justify-center border border-amber-300/50">
                <svg class="h-4 w-4 text-amber-100 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                </svg>
              </div>
              <div>
                <div class="text-sm font-medium opacity-90">In Progress</div>
                <div class="text-lg font-bold"><%= @analysis_requests.where.not(status: [:completed, :failed]).count %></div>
              </div>
            </div>
            
            <div class="flex items-center space-x-2">
              <div class="h-8 w-8 bg-red-500/30 rounded-lg flex items-center justify-center border border-red-300/50">
                <svg class="h-4 w-4 text-red-100" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                </svg>
              </div>
              <div>
                <div class="text-sm font-medium opacity-90">Failed</div>
                <div class="text-lg font-bold"><%= @analysis_requests.where(status: :failed).count %></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Header Actions -->
        <div class="flex flex-col sm:flex-row items-center space-y-3 sm:space-y-0 sm:space-x-3">
          <% if params[:dataset_id].present? && @analysis_requests.first&.dataset %>
            <%= link_to @analysis_requests.first.dataset, class: "w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-amber-500 to-amber-600 border border-transparent rounded-xl shadow-lg text-sm font-semibold text-white hover:from-amber-600 hover:to-amber-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-amber-500 transform hover:scale-105 transition-all duration-200" do %>
              <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
              </svg>
              New Analysis
            <% end %>
          <% end %>
          <%= link_to datasets_path, class: "w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 bg-white/20 border border-white/30 rounded-xl shadow-lg text-sm font-medium text-white hover:bg-white/30 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-white/50 backdrop-blur-sm transition-all duration-200" do %>
            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"></path>
            </svg>
            View Datasets
          <% end %>
        </div>
      </div>
    </div>
  </div>


  <!-- Advanced Filters & Search -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="bg-white/70 dark:bg-slate-800/70 backdrop-blur-sm shadow-xl rounded-2xl border border-slate-200/50 dark:border-slate-700/50 overflow-hidden">
      <div class="bg-gradient-to-r from-purple-500 to-indigo-600 px-6 py-4">
        <div class="flex items-center space-x-3">
          <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
          </svg>
          <h2 class="text-lg font-bold text-white">Filter & Search</h2>
        </div>
      </div>
      
      <div class="px-6 py-6">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
          <!-- Status Filters -->
          <div class="flex flex-wrap items-center gap-3">
            <label class="text-sm font-semibold text-slate-700 dark:text-slate-300">Status:</label>
            <div class="flex flex-wrap gap-2">
              <%= link_to analysis_requests_path(dataset_id: params[:dataset_id]), class: "group relative inline-flex items-center px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-200 #{params[:status].blank? ? 'bg-gradient-to-r from-purple-600 to-indigo-600 text-white shadow-lg shadow-purple-500/50' : 'bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-600'}" do %>
                <svg class="h-4 w-4 mr-1.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zm0 6a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1v-2zm0 6a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1v-2z" clip-rule="evenodd"></path>
                </svg>
                All
              <% end %>
              
              <%= link_to analysis_requests_path(status: 'completed', dataset_id: params[:dataset_id]), class: "group relative inline-flex items-center px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-200 #{params[:status] == 'completed' ? 'bg-gradient-to-r from-green-600 to-emerald-600 text-white shadow-lg shadow-green-500/50' : 'bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-600'}" do %>
                <svg class="h-4 w-4 mr-1.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                Completed
              <% end %>
              
              <%= link_to analysis_requests_path(status: 'pending', dataset_id: params[:dataset_id]), class: "group relative inline-flex items-center px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-200 #{params[:status] == 'pending' ? 'bg-gradient-to-r from-amber-600 to-orange-600 text-white shadow-lg shadow-amber-500/50' : 'bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-600'}" do %>
                <svg class="h-4 w-4 mr-1.5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                </svg>
                Pending
              <% end %>
              
              <%= link_to analysis_requests_path(status: 'failed', dataset_id: params[:dataset_id]), class: "group relative inline-flex items-center px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-200 #{params[:status] == 'failed' ? 'bg-gradient-to-r from-red-600 to-rose-600 text-white shadow-lg shadow-red-500/50' : 'bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-600'}" do %>
                <svg class="h-4 w-4 mr-1.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                </svg>
                Failed
              <% end %>
            </div>
          </div>

          <!-- View Options -->
          <div class="flex items-center space-x-3">
            <div class="text-sm font-medium text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-700 px-4 py-2 rounded-lg">
              <span class="font-bold text-slate-900 dark:text-slate-100"><%= @analysis_requests.total_count %></span> results
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-8">
    <% if @analysis_requests.any? %>
      <!-- Premium Analysis Cards Grid -->
      <div class="space-y-4">
        <% @analysis_requests.each do |analysis_request| %>
          <div class="group bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden hover:shadow-lg transition-all duration-200">
            <div class="p-6">
              <div class="flex items-start gap-4">
                <!-- Status Icon -->
                <div class="flex-shrink-0 mt-1">
                  <div class="h-14 w-14 rounded-2xl flex items-center justify-center
                    <%= case analysis_request.status
                        when 'completed' then 'bg-gradient-to-br from-orange-400 to-orange-500'
                        when 'pending', 'analyzing', 'generating_code', 'executing', 'interpreting_results' then 'bg-gradient-to-br from-orange-400 to-orange-500'
                        when 'failed' then 'bg-gradient-to-br from-red-400 to-red-500'
                        else 'bg-gradient-to-br from-slate-400 to-slate-500'
                        end %>">
                    <% case analysis_request.status %>
                    <% when 'completed' %>
                      <svg class="h-7 w-7 text-white" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                      </svg>
                    <% when 'pending', 'analyzing', 'generating_code', 'executing', 'interpreting_results' %>
                      <svg class="h-7 w-7 text-white animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                      </svg>
                    <% when 'failed' %>
                      <svg class="h-7 w-7 text-white" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                      </svg>
                    <% else %>
                      <svg class="h-7 w-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                      </svg>
                    <% end %>
                  </div>
                </div>
                
                <!-- Main Content -->
                <div class="flex-1 min-w-0">
                  <!-- Title -->
                  <%= link_to analysis_request, class: "block mb-3" do %>
                    <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors">
                      <%= analysis_request.natural_language_query %>
                    </h3>
                  <% end %>
                  
                  <!-- Metadata Row -->
                  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-slate-600 dark:text-slate-400">
                    <% if analysis_request.dataset %>
                      <div class="flex items-center gap-1.5">
                        <svg class="h-4 w-4 text-teal-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"></path>
                        </svg>
                        <%= link_to analysis_request.dataset.name, analysis_request.dataset, class: "hover:text-teal-600 dark:hover:text-teal-400 transition-colors" %>
                      </div>
                    <% end %>
                    
                    <% if analysis_request.user %>
                      <div class="flex items-center gap-1.5">
                        <svg class="h-4 w-4 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        <span><%= analysis_request.user.first_name || analysis_request.user.email.split('@').first %></span>
                      </div>
                    <% end %>
                    
                    <div class="flex items-center gap-1.5">
                      <svg class="h-4 w-4 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                      <span><%= time_ago_in_words(analysis_request.created_at) %> ago</span>
                    </div>
                  </div>
                </div>

                <!-- Right Side: Status Badge & Actions -->
                <div class="flex flex-col items-end gap-3 flex-shrink-0">
                  <!-- Status Badge -->
                  <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-semibold
                    <%= case analysis_request.status
                        when 'completed' then 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400'
                        when 'pending', 'analyzing', 'generating_code', 'executing', 'interpreting_results' then 'bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400'
                        when 'failed' then 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400'
                        else 'bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-300'
                        end %>">
                    <%= analysis_request.status.humanize %>
                  </span>
                  
                  <!-- Action Buttons -->
                  <div class="flex items-center gap-2">
                    <%= link_to analysis_request, class: "inline-flex items-center px-4 py-2 bg-white dark:bg-slate-700 border border-slate-300 dark:border-slate-600 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-600 transition-colors" do %>
                      View Details
                    <% end %>
                    
                    <%= link_to analysis_request, method: :delete, data: { confirm: "Are you sure you want to delete this analysis?" }, class: "inline-flex items-center p-2 border border-slate-300 dark:border-slate-600 rounded-lg text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/10 transition-colors" do %>
                      <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                      </svg>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Pagination -->
      <% if @analysis_requests.total_pages > 1 %>
        <div class="mt-8 flex justify-center">
          <%= paginate @analysis_requests, theme: 'twitter-bootstrap-4', outer_window: 1, inner_window: 2 %>
        </div>
      <% end %>
    <% else %>
      <!-- Empty State -->
      <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
        <div class="px-6 py-16 text-center">
          <div class="mx-auto h-20 w-20 bg-slate-100 dark:bg-slate-700 rounded-2xl flex items-center justify-center mb-6">
            <svg class="h-10 w-10 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
            </svg>
          </div>
          
          <h3 class="text-xl font-semibold text-slate-900 dark:text-slate-100 mb-2">
            <% if params[:status].present? %>
              No <%= params[:status] %> analyses found
            <% else %>
              No Analysis History Yet
            <% end %>
          </h3>
          
          <p class="text-slate-600 dark:text-slate-400 mb-8 max-w-md mx-auto">
            <% if params[:status].present? %>
              There are no analysis requests with status "<%= params[:status].humanize %>". Try selecting a different filter.
            <% elsif params[:dataset_id].present? %>
              Start analyzing this dataset to see your analysis history here.
            <% else %>
              Begin your data analysis journey. Connect your data sources and start exploring.
            <% end %>
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <% if params[:dataset_id].present? && @analysis_requests.first&.dataset %>
              <%= link_to @analysis_requests.first.dataset, class: "inline-flex items-center px-6 py-3 bg-orange-500 border border-transparent rounded-lg shadow-sm text-sm font-semibold text-white hover:bg-orange-600 transition-colors" do %>
                <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                </svg>
                Start New Analysis
              <% end %>
            <% else %>
              <%= link_to datasets_path, class: "inline-flex items-center px-6 py-3 bg-orange-500 border border-transparent rounded-lg shadow-sm text-sm font-semibold text-white hover:bg-orange-600 transition-colors" do %>
                <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"></path>
                </svg>
                View Data Sources
              <% end %>
            <% end %>
            
            <% if params[:status].present? %>
              <%= link_to "Clear Filters", analysis_requests_path(dataset_id: params[:dataset_id]), class: "inline-flex items-center px-6 py-3 border border-slate-300 dark:border-slate-600 rounded-lg text-sm font-semibold text-slate-700 dark:text-slate-300 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors" do %>
                <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
                Clear Filters
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<script>
  // Auto-refresh for in-progress analyses
  <% if @analysis_requests.any? { |ar| ['pending', 'analyzing', 'generating_code', 'executing', 'interpreting_results'].include?(ar.status) } %>
    setTimeout(function() {
      location.reload();
    }, 10000); // Refresh every 10 seconds if there are active analyses
  <% end %>
</script>