<% content_for :title, "Analysis Request ##{@analysis_request.id}" %>

<!-- Premium Analysis Request Detail Page -->
<div class="bg-gradient-to-br from-slate-50 via-teal-50 to-cyan-50 dark:from-slate-900 dark:via-slate-800 dark:to-slate-900 min-h-screen pt-20">
  <!-- Breadcrumb & Navigation -->
  <div class="bg-white/80 dark:bg-slate-800/80 backdrop-blur-sm border-b border-slate-200/50 dark:border-slate-700/50 sticky top-16 z-10">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <nav class="flex items-center space-x-2 text-sm">
        <%= link_to "Analysis History", analysis_requests_path, class: "text-slate-500 dark:text-slate-400 hover:text-teal-600 dark:hover:text-teal-400 transition-colors" %>
        <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
        <% if @analysis_request.dataset %>
          <%= link_to @analysis_request.dataset.name, @analysis_request.dataset, class: "text-slate-500 dark:text-slate-400 hover:text-teal-600 dark:hover:text-teal-400 transition-colors" %>
          <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        <% end %>
        <span class="text-slate-900 dark:text-slate-100 font-medium">Analysis #<%= @analysis_request.id %></span>
      </nav>
    </div>
  </div>

  <!-- Hero Header Section -->
  <div class="relative bg-gradient-to-r from-teal-600 via-cyan-600 to-blue-600 shadow-xl">
    <div class="absolute inset-0 bg-black/20"></div>
    <div class="relative max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between space-y-6 lg:space-y-0">
        <!-- Analysis Header Info -->
        <div class="flex-1 min-w-0">
          <div class="flex items-start space-x-4">
            <!-- Status Icon -->
            <div class="flex-shrink-0">
              <div class="h-16 w-16 bg-white/20 dark:bg-slate-800/30 rounded-xl flex items-center justify-center backdrop-blur-sm">
                <% case @analysis_request.status %>
                <% when 'completed' %>
                  <svg class="h-8 w-8 text-green-300" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                  </svg>
                <% when 'pending', 'analyzing', 'generating_code', 'executing', 'interpreting_results' %>
                  <svg class="h-8 w-8 text-amber-300 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                  </svg>
                <% when 'failed' %>
                  <svg class="h-8 w-8 text-red-300" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                  </svg>
                <% else %>
                  <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                  </svg>
                <% end %>
              </div>
            </div>
            
            <div class="min-w-0 flex-1">
              <div class="flex items-center space-x-3 mb-3">
                <h1 class="text-3xl lg:text-4xl font-bold text-white">Analysis Request</h1>
                <span class="inline-flex items-center px-4 py-1.5 rounded-full text-sm font-semibold backdrop-blur-sm border
                  <%= case @analysis_request.status
                      when 'completed' then 'bg-green-500/30 text-green-100 border-green-300/50'
                      when 'pending', 'analyzing', 'generating_code', 'executing', 'interpreting_results' then 'bg-amber-500/30 text-amber-100 border-amber-300/50'
                      when 'failed' then 'bg-red-500/30 text-red-100 border-red-300/50'
                      when 'requires_clarification' then 'bg-blue-500/30 text-blue-100 border-blue-300/50'
                      else 'bg-slate-500/30 text-slate-100 border-slate-300/50'
                      end %>">
                  <%= @analysis_request.status.humanize %>
                </span>
              </div>
              
              <p class="text-lg text-teal-100 mb-4 leading-relaxed">
                <%= @analysis_request.natural_language_query %>
              </p>
              
              <div class="flex flex-wrap items-center gap-6 text-sm text-teal-100">
                <div class="flex items-center space-x-2">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span>Created <%= time_ago_in_words(@analysis_request.created_at) %> ago</span>
                </div>
                <% if @analysis_request.dataset %>
                  <div class="flex items-center space-x-2">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"></path>
                    </svg>
                    <%= link_to @analysis_request.dataset.name, @analysis_request.dataset, class: "hover:underline" %>
                  </div>
                <% end %>
                <% if @analysis_request.user %>
                  <div class="flex items-center space-x-2">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                    <span><%= @analysis_request.user.first_name || @analysis_request.user.email.split('@').first %></span>
                  </div>
                <% end %>
                <% if @analysis_request.execution_time %>
                  <div class="flex items-center space-x-2">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                    <span>Executed in <%= number_to_human(@analysis_request.execution_time, units: :time, precision: 2) %></span>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center space-y-3 sm:space-y-0 sm:space-x-3">
          <% if @analysis_request.status == 'completed' %>
            <div class="relative">
              <button type="button" onclick="toggleExportMenu()" class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-amber-500 to-amber-600 border border-transparent rounded-xl shadow-lg text-sm font-semibold text-white hover:from-amber-600 hover:to-amber-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-amber-500 transform hover:scale-105 transition-all duration-200">
                <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                </svg>
                Export Results
                <svg class="h-4 w-4 ml-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                </svg>
              </button>
              <div id="exportMenu" class="hidden absolute right-0 mt-2 w-48 rounded-xl shadow-2xl bg-white dark:bg-slate-800 ring-1 ring-black ring-opacity-5 z-20 overflow-hidden">
                <div class="py-1">
                  <%= link_to export_analysis_request_path(@analysis_request, format: :json), class: "flex items-center px-4 py-3 text-sm text-slate-700 dark:text-slate-300 hover:bg-teal-50 dark:hover:bg-slate-700 transition-colors" do %>
                    <svg class="h-4 w-4 mr-3 text-teal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                    </svg>
                    Export as JSON
                  <% end %>
                  <%= link_to export_analysis_request_path(@analysis_request, format: :csv), class: "flex items-center px-4 py-3 text-sm text-slate-700 dark:text-slate-300 hover:bg-teal-50 dark:hover:bg-slate-700 transition-colors" do %>
                    <svg class="h-4 w-4 mr-3 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    Export as CSV
                  <% end %>
                  <%= link_to export_analysis_request_path(@analysis_request, format: :xlsx), class: "flex items-center px-4 py-3 text-sm text-slate-700 dark:text-slate-300 hover:bg-teal-50 dark:hover:bg-slate-700 transition-colors" do %>
                    <svg class="h-4 w-4 mr-3 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    Export as Excel
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
          
          <%= link_to analysis_requests_path, class: "w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 bg-white/20 border border-white/30 rounded-xl shadow-lg text-sm font-medium text-white hover:bg-white/30 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-white/50 backdrop-blur-sm transition-all duration-200" do %>
            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Back to History
          <% end %>
          
          <%= link_to @analysis_request, method: :delete, data: { confirm: "Are you sure you want to delete this analysis?" }, class: "w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 bg-red-500/20 border border-red-300/30 rounded-xl shadow-lg text-sm font-medium text-red-100 hover:bg-red-500/30 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 backdrop-blur-sm transition-all duration-200" do %>
            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
            Delete
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Primary Content Area -->
      <div class="lg:col-span-2 space-y-8">
        <!-- Analysis Progress Timeline -->
        <div class="bg-white/70 dark:bg-slate-800/70 backdrop-blur-sm shadow-xl rounded-2xl border border-slate-200/50 dark:border-slate-700/50 overflow-hidden">
          <div class="bg-gradient-to-r from-purple-500 to-indigo-600 px-6 py-4">
            <div class="flex items-center space-x-3">
              <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
              </svg>
              <h2 class="text-xl font-bold text-white">Analysis Timeline</h2>
            </div>
          </div>
          
          <div class="px-6 py-8">
            <!-- Progress Steps -->
            <div class="relative">
              <% 
                steps = [
                  { key: 'pending', label: 'Request Received', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
                  { key: 'analyzing', label: 'Analyzing Query', icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z' },
                  { key: 'generating_code', label: 'Generating Code', icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4' },
                  { key: 'executing', label: 'Executing Analysis', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
                  { key: 'interpreting_results', label: 'Interpreting Results', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' },
                  { key: 'completed', label: 'Analysis Complete', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' }
                ]
                
                current_step_index = steps.find_index { |s| s[:key].to_s == @analysis_request.status } || 0
                is_failed = @analysis_request.status == 'failed'
              %>
              
              <% steps.each_with_index do |step, index| %>
                <% 
                  is_current = index == current_step_index
                  is_completed = index < current_step_index || @analysis_request.status == 'completed'
                  is_upcoming = index > current_step_index && !is_failed
                %>
                
                <div class="flex items-start mb-8 last:mb-0 relative">
                  <!-- Connector Line -->
                  <% unless index == steps.length - 1 %>
                    <div class="absolute left-5 top-12 bottom-0 w-0.5 <%= is_completed ? 'bg-gradient-to-b from-teal-500 to-teal-600' : 'bg-slate-200 dark:bg-slate-700' %>"></div>
                  <% end %>
                  
                  <!-- Step Icon -->
                  <div class="relative flex-shrink-0">
                    <div class="h-10 w-10 rounded-full flex items-center justify-center border-2 transition-all duration-300
                      <%= if is_completed
                            'bg-gradient-to-br from-teal-500 to-cyan-600 border-teal-400 shadow-lg shadow-teal-500/50'
                          elsif is_current && !is_failed
                            'bg-gradient-to-br from-amber-500 to-amber-600 border-amber-400 shadow-lg shadow-amber-500/50 animate-pulse'
                          elsif is_failed && is_current
                            'bg-gradient-to-br from-red-500 to-red-600 border-red-400 shadow-lg shadow-red-500/50'
                          else
                            'bg-slate-100 dark:bg-slate-700 border-slate-300 dark:border-slate-600'
                          end %>">
                      <% if is_completed %>
                        <svg class="h-5 w-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                        </svg>
                      <% elsif is_failed && is_current %>
                        <svg class="h-5 w-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                        </svg>
                      <% else %>
                        <svg class="h-5 w-5 <%= is_current ? 'text-white' : 'text-slate-400 dark:text-slate-500' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= step[:icon] %>"></path>
                        </svg>
                      <% end %>
                    </div>
                  </div>
                  
                  <!-- Step Content -->
                  <div class="ml-4 flex-1">
                    <div class="flex items-center justify-between mb-1">
                      <h3 class="text-base font-semibold <%= is_current ? 'text-teal-600 dark:text-teal-400' : 'text-slate-900 dark:text-slate-100' %>">
                        <%= step[:label] %>
                      </h3>
                      <% if is_current && !is_failed %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300">
                          In Progress
                        </span>
                      <% elsif is_completed %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-teal-100 text-teal-800 dark:bg-teal-900/30 dark:text-teal-300">
                          Completed
                        </span>
                      <% end %>
                    </div>
                    <p class="text-sm text-slate-500 dark:text-slate-400">
                      <%= case step[:key].to_s
                          when 'pending' then 'Your analysis request has been received and queued for processing'
                          when 'analyzing' then 'AI is analyzing your natural language query to understand requirements'
                          when 'generating_code' then 'Generating optimized code to perform the requested analysis'
                          when 'executing' then 'Running the analysis in a secure containerized environment'
                          when 'interpreting_results' then 'AI is interpreting the results and generating insights'
                          when 'completed' then 'Analysis has been completed successfully with actionable insights'
                          end %>
                    </p>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Execution Steps -->
        <% if @execution_steps.any? %>
          <div class="bg-white/70 dark:bg-slate-800/70 backdrop-blur-sm shadow-xl rounded-2xl border border-slate-200/50 dark:border-slate-700/50 overflow-hidden">
            <div class="bg-gradient-to-r from-cyan-500 to-blue-600 px-6 py-4">
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-3">
                  <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                  </svg>
                  <h2 class="text-xl font-bold text-white">Execution Steps</h2>
                </div>
                <span class="text-teal-100 text-sm font-medium"><%= pluralize(@execution_steps.count, 'step') %></span>
              </div>
            </div>
            
            <div class="divide-y divide-slate-200/50 dark:divide-slate-700/50">
              <% @execution_steps.each_with_index do |step, index| %>
                <div class="px-6 py-6 hover:bg-slate-50/50 dark:hover:bg-slate-700/30 transition-all duration-200">
                  <!-- Step Header -->
                  <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center space-x-3">
                      <span class="inline-flex items-center justify-center h-8 w-8 rounded-lg text-sm font-bold bg-gradient-to-br from-cyan-500 to-blue-600 text-white shadow-lg">
                        <%= index + 1 %>
                      </span>
                      <div>
                        <h3 class="text-base font-semibold text-slate-900 dark:text-slate-100">
                          <%= step.step_type.humanize %>
                        </h3>
                        <p class="text-sm text-slate-500 dark:text-slate-400">
                          <%= step.language.humanize %> • 
                          <% if step.duration_seconds %>
                            Executed in <%= number_to_human(step.duration_seconds, units: :time, precision: 2) %>
                          <% else %>
                            Duration unknown
                          <% end %>
                        </p>
                      </div>
                    </div>
                    
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border
                      <%= case step.status
                          when 'completed' then 'bg-green-50 text-green-700 border-green-200 dark:bg-green-900/30 dark:text-green-300 dark:border-green-700'
                          when 'executing', 'generating', 'validating' then 'bg-amber-50 text-amber-700 border-amber-200 dark:bg-amber-900/30 dark:text-amber-300 dark:border-amber-700'
                          when 'failed', 'timeout' then 'bg-red-50 text-red-700 border-red-200 dark:bg-red-900/30 dark:text-red-300 dark:border-red-700'
                          else 'bg-slate-50 text-slate-700 border-slate-200 dark:bg-slate-900/30 dark:text-slate-300 dark:border-slate-700'
                          end %>">
                      <%= step.status.humanize %>
                    </span>
                  </div>
                  
                  <!-- Generated Code -->
                  <% if step.generated_code.present? %>
                    <div class="mb-4">
                      <button onclick="toggleCode(<%= step.id %>)" class="flex items-center justify-between w-full px-4 py-2 bg-slate-100 dark:bg-slate-700/50 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
                        <span class="flex items-center space-x-2">
                          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                          </svg>
                          <span>View Generated Code</span>
                        </span>
                        <svg id="code-icon-<%= step.id %>" class="h-4 w-4 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                      </button>
                      <div id="code-<%= step.id %>" class="hidden mt-3">
                        <pre class="bg-slate-900 dark:bg-slate-950 rounded-lg p-4 overflow-x-auto border border-slate-700"><code class="text-sm text-slate-100 font-mono"><%= step.generated_code %></code></pre>
                      </div>
                    </div>
                  <% end %>
                  
                  <!-- Results -->
                  <% if step.result_data.present? %>
                    <div class="bg-gradient-to-br from-teal-50 to-cyan-50 dark:from-teal-900/20 dark:to-cyan-900/20 rounded-lg p-4 border border-teal-200 dark:border-teal-800">
                      <h4 class="text-sm font-semibold text-slate-900 dark:text-slate-100 mb-3 flex items-center">
                        <svg class="h-4 w-4 mr-2 text-teal-600 dark:text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        Execution Results
                      </h4>
                      <div class="bg-white dark:bg-slate-800 rounded-lg p-3 overflow-x-auto">
                        <pre class="text-xs text-slate-700 dark:text-slate-300"><%= JSON.pretty_generate(step.result_data) %></pre>
                      </div>
                    </div>
                  <% end %>
                  
                  <!-- Error Message -->
                  <% if step.error_message.present? %>
                    <div class="bg-red-50 dark:bg-red-900/20 rounded-lg p-4 border border-red-200 dark:border-red-800">
                      <h4 class="text-sm font-semibold text-red-900 dark:text-red-100 mb-2 flex items-center">
                        <svg class="h-4 w-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                        </svg>
                        Error Details
                      </h4>
                      <p class="text-sm text-red-800 dark:text-red-200 font-mono"><%= step.error_message %></p>
                    </div>
                  <% end %>
                  
                  <!-- Resource Usage -->
                  <% if step.resource_usage.present? %>
                    <div class="mt-4 grid grid-cols-2 md:grid-cols-4 gap-4">
                      <% if step.cpu_time_ms %>
                        <div class="bg-white dark:bg-slate-800 rounded-lg p-3 border border-slate-200 dark:border-slate-700">
                          <div class="text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">CPU Time</div>
                          <div class="text-lg font-bold text-slate-900 dark:text-slate-100"><%= step.cpu_time_ms %>ms</div>
                        </div>
                      <% end %>
                      <% if step.memory_mb %>
                        <div class="bg-white dark:bg-slate-800 rounded-lg p-3 border border-slate-200 dark:border-slate-700">
                          <div class="text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Memory</div>
                          <div class="text-lg font-bold text-slate-900 dark:text-slate-100"><%= step.memory_mb %>MB</div>
                        </div>
                      <% end %>
                      <% if step.execution_time_ms %>
                        <div class="bg-white dark:bg-slate-800 rounded-lg p-3 border border-slate-200 dark:border-slate-700">
                          <div class="text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Execution</div>
                          <div class="text-lg font-bold text-slate-900 dark:text-slate-100"><%= step.execution_time_ms %>ms</div>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Error Message -->
        <% if @analysis_request.error_message.present? %>
          <div class="bg-white/70 dark:bg-slate-800/70 backdrop-blur-sm shadow-xl rounded-2xl border border-red-300/50 dark:border-red-700/50 overflow-hidden">
            <div class="bg-gradient-to-r from-red-500 to-red-600 px-6 py-4">
              <div class="flex items-center space-x-3">
                <svg class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                </svg>
                <h2 class="text-xl font-bold text-white">Error Details</h2>
              </div>
            </div>
            <div class="px-6 py-6">
              <div class="bg-red-50 dark:bg-red-900/20 rounded-lg p-4 border border-red-200 dark:border-red-800">
                <p class="text-sm text-red-900 dark:text-red-100 font-mono"><%= @analysis_request.error_message %></p>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        <!-- Request Information -->
        <div class="bg-white/70 dark:bg-slate-800/70 backdrop-blur-sm shadow-xl rounded-2xl border border-slate-200/50 dark:border-slate-700/50 overflow-hidden">
          <div class="bg-gradient-to-r from-slate-500 to-slate-600 px-6 py-4">
            <div class="flex items-center space-x-3">
              <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <h3 class="text-lg font-bold text-white">Request Details</h3>
            </div>
          </div>
          <div class="px-6 py-6 space-y-4">
            <div class="flex items-center justify-between py-3 border-b border-slate-200/50 dark:border-slate-700/50">
              <dt class="text-sm font-medium text-slate-500 dark:text-slate-400">Request ID</dt>
              <dd class="text-sm font-mono font-semibold text-slate-900 dark:text-slate-100">#<%= @analysis_request.id %></dd>
            </div>
            <div class="flex items-center justify-between py-3 border-b border-slate-200/50 dark:border-slate-700/50">
              <dt class="text-sm font-medium text-slate-500 dark:text-slate-400">Status</dt>
              <dd>
                <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold border
                  <%= case @analysis_request.status
                      when 'completed' then 'bg-green-50 text-green-700 border-green-200 dark:bg-green-900/30 dark:text-green-300 dark:border-green-700'
                      when 'pending', 'analyzing', 'generating_code', 'executing', 'interpreting_results' then 'bg-amber-50 text-amber-700 border-amber-200 dark:bg-amber-900/30 dark:text-amber-300 dark:border-amber-700'
                      when 'failed' then 'bg-red-50 text-red-700 border-red-200 dark:bg-red-900/30 dark:text-red-300 dark:border-red-700'
                      else 'bg-slate-50 text-slate-700 border-slate-200 dark:bg-slate-900/30 dark:text-slate-300 dark:border-slate-700'
                      end %>">
                  <%= @analysis_request.status.humanize %>
                </span>
              </dd>
            </div>
            <% if @analysis_request.complexity_score %>
              <div class="flex items-center justify-between py-3 border-b border-slate-200/50 dark:border-slate-700/50">
                <dt class="text-sm font-medium text-slate-500 dark:text-slate-400">Complexity</dt>
                <dd class="text-sm font-semibold text-slate-900 dark:text-slate-100">
                  <%= number_to_percentage(@analysis_request.complexity_score * 10, precision: 0) %>
                </dd>
              </div>
            <% end %>
            <div class="flex items-center justify-between py-3 border-b border-slate-200/50 dark:border-slate-700/50">
              <dt class="text-sm font-medium text-slate-500 dark:text-slate-400">Created At</dt>
              <dd class="text-sm font-semibold text-slate-900 dark:text-slate-100">
                <%= @analysis_request.created_at.strftime("%b %d, %Y %I:%M %p") %>
              </dd>
            </div>
            <% if @analysis_request.completed_at %>
              <div class="flex items-center justify-between py-3 border-b border-slate-200/50 dark:border-slate-700/50">
                <dt class="text-sm font-medium text-slate-500 dark:text-slate-400">Completed At</dt>
                <dd class="text-sm font-semibold text-slate-900 dark:text-slate-100">
                  <%= @analysis_request.completed_at.strftime("%b %d, %Y %I:%M %p") %>
                </dd>
              </div>
            <% end %>
            <% if @analysis_request.execution_time %>
              <div class="flex items-center justify-between py-3">
                <dt class="text-sm font-medium text-slate-500 dark:text-slate-400">Total Duration</dt>
                <dd class="text-sm font-bold text-teal-600 dark:text-teal-400">
                  <%= number_to_human(@analysis_request.execution_time, units: :time, precision: 2) %>
                </dd>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Dataset Information -->
        <% if @analysis_request.dataset %>
          <div class="bg-white/70 dark:bg-slate-800/70 backdrop-blur-sm shadow-xl rounded-2xl border border-slate-200/50 dark:border-slate-700/50 overflow-hidden">
            <div class="bg-gradient-to-r from-teal-500 to-cyan-600 px-6 py-4">
              <div class="flex items-center space-x-3">
                <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"></path>
                </svg>
                <h3 class="text-lg font-bold text-white">Dataset</h3>
              </div>
            </div>
            <div class="px-6 py-6">
              <div class="space-y-4">
                <div>
                  <h4 class="text-base font-semibold text-slate-900 dark:text-slate-100 mb-2">
                    <%= link_to @analysis_request.dataset.name, @analysis_request.dataset, class: "hover:text-teal-600 dark:hover:text-teal-400 transition-colors" %>
                  </h4>
                  <p class="text-sm text-slate-500 dark:text-slate-400">
                    <%= @analysis_request.dataset.description&.truncate(100) || "No description available" %>
                  </p>
                </div>
                <div class="flex items-center justify-between py-2 border-t border-slate-200/50 dark:border-slate-700/50">
                  <span class="text-xs font-medium text-slate-500 dark:text-slate-400">Type</span>
                  <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-semibold bg-teal-50 text-teal-700 dark:bg-teal-900/30 dark:text-teal-300">
                    <%= @analysis_request.dataset.data_source_type&.humanize %>
                  </span>
                </div>
                <%= link_to "View Dataset Details", @analysis_request.dataset, class: "w-full flex items-center justify-center px-4 py-2 bg-gradient-to-r from-teal-600 to-cyan-600 border border-transparent rounded-lg shadow-lg text-sm font-semibold text-white hover:from-teal-700 hover:to-cyan-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-teal-500 transform hover:scale-105 transition-all duration-200" %>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Quick Actions -->
        <div class="bg-white/70 dark:bg-slate-800/70 backdrop-blur-sm shadow-xl rounded-2xl border border-slate-200/50 dark:border-slate-700/50 overflow-hidden">
          <div class="bg-gradient-to-r from-amber-500 to-amber-600 px-6 py-4">
            <div class="flex items-center space-x-3">
              <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
              <h3 class="text-lg font-bold text-white">Quick Actions</h3>
            </div>
          </div>
          <div class="px-6 py-6 space-y-3">
            <% if @analysis_request.dataset %>
              <%= link_to "New Analysis", @analysis_request.dataset, class: "w-full flex items-center justify-center px-4 py-2.5 bg-gradient-to-r from-teal-600 to-cyan-600 border border-transparent rounded-lg shadow-lg text-sm font-semibold text-white hover:from-teal-700 hover:to-cyan-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-teal-500 transform hover:scale-105 transition-all duration-200" %>
            <% end %>
            <%= link_to "View All Analyses", analysis_requests_path, class: "w-full flex items-center justify-center px-4 py-2.5 border-2 border-slate-300 dark:border-slate-600 rounded-lg shadow-lg text-sm font-semibold text-slate-700 dark:text-slate-300 bg-white/50 dark:bg-slate-800/50 hover:bg-slate-50 dark:hover:bg-slate-700/50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-500 backdrop-blur-sm transition-all duration-200" %>
            <%= link_to "Data Sources", datasets_path, class: "w-full flex items-center justify-center px-4 py-2.5 border-2 border-slate-300 dark:border-slate-600 rounded-lg shadow-lg text-sm font-semibold text-slate-700 dark:text-slate-300 bg-white/50 dark:bg-slate-800/50 hover:bg-slate-50 dark:hover:bg-slate-700/50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-500 backdrop-blur-sm transition-all duration-200" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- JavaScript -->
<script>
  function toggleExportMenu() {
    const menu = document.getElementById('exportMenu');
    menu.classList.toggle('hidden');
  }

  function toggleCode(stepId) {
    const codeBlock = document.getElementById(`code-${stepId}`);
    const icon = document.getElementById(`code-icon-${stepId}`);
    codeBlock.classList.toggle('hidden');
    icon.classList.toggle('rotate-180');
  }

  // Close export menu when clicking outside
  document.addEventListener('click', function(event) {
    const menu = document.getElementById('exportMenu');
    if (menu && !event.target.closest('button[onclick="toggleExportMenu()"]') && !menu.contains(event.target)) {
      menu.classList.add('hidden');
    }
  });

  // Auto-refresh for in-progress analyses
  <% if ['pending', 'analyzing', 'generating_code', 'executing', 'interpreting_results'].include?(@analysis_request.status) %>
    setTimeout(function() {
      location.reload();
    }, 5000); // Refresh every 5 seconds
  <% end %>
</script>
